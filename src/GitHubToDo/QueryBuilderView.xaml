<UserControl
    x:Class="GitHubToDo.QueryBuilderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubToDo"
    xmlns:vm="using:GitHubToDo.ViewModels"
    xmlns:core="using:GitHubToDo.Core">
    <UserControl.Resources>
        <FontFamily x:Key="QueryFont">Cascadia Mono, Consolas</FontFamily>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <LinearGradientBrush x:Key="AiBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B61FF" Offset="0" />
            <GradientStop Color="#2F80ED" Offset="0.55" />
            <GradientStop Color="#1FB59A" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" ColumnSpacing="20" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ComposeColumn" Width="1.25*" />
            <ColumnDefinition x:Name="ReferenceColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Narrow windows show one pane at a time -->
        <SelectorBar x:Name="PaneSelector" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,0,0,8"
                     SelectionChanged="PaneSelector_SelectionChanged" AutomationProperties.AutomationId="QueryBuilderPanes">
            <SelectorBarItem x:Name="ComposePaneItem" Text="Compose" IsSelected="True" AutomationProperties.AutomationId="ComposePane" />
            <SelectorBarItem Text="Reference" AutomationProperties.AutomationId="ReferencePane" />
        </SelectorBar>

        <!-- Compose: describe, edit, validate and preview -->
        <ScrollViewer x:Name="ComposePanel" Grid.Row="1" Padding="0,0,14,0" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="QueryComposer">
            <StackPanel Spacing="16" Padding="0,0,0,8">
                <Border BorderBrush="{StaticResource AiBorderBrush}" BorderThickness="1.5" CornerRadius="{StaticResource OverlayCornerRadius}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,14"
                        Visibility="{x:Bind ViewModel.IsAiAvailable}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PathIcon x:Name="AiIcon" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Describe what you want to track" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="The on-device model writes the query, then it's checked against GitHub and corrected until it works."
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="DescriptionBox" Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="e.g. Open PRs in dotnet/maui waiting for my review, updated in the last month"
                                 TextWrapping="Wrap" AcceptsReturn="False" KeyDown="Description_KeyDown"
                                 AutomationProperties.Name="Describe the issues or pull requests you want"
                                 AutomationProperties.AutomationId="QueryDescription" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.GenerateCommand}"
                                    AutomationProperties.AutomationId="GenerateQuery">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon x:Name="GenerateIcon" Width="14" Height="14" />
                                    <TextBlock Text="Generate query" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.GenerationStatus, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.GenerationStatus), Mode=OneWay}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GenerationStatus" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Attempts}" AutomationProperties.AutomationId="GenerationAttempts">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </ItemsControl.ItemContainerTransitions>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueryAttemptRow">
                                    <Grid ColumnSpacing="10" Padding="0,6,0,0" AutomationProperties.Name="{x:Bind local:QueryBuilderView.AttemptName(Header, Expression, Outcome)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{x:Bind local:QueryBuilderView.OutcomeBrush(Succeeded)}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Expression}" FontFamily="{StaticResource QueryFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Outcome}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Describe-to-query needs local AI"
                         Message="{x:Bind ViewModel.AiDescription}" Visibility="{x:Bind local:QueryBuilderView.Collapsed(ViewModel.IsAiAvailable)}"
                         AutomationProperties.AutomationId="QueryAiUnavailable" />

                <TextBox x:Name="NameBox" Header="Display name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         PlaceholderText="Shown in the sidebar" AutomationProperties.AutomationId="QueryName" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Search query" Margin="0,0,0,-2" />
                    <TextBox x:Name="ExpressionBox" AutomationProperties.Name="Search query" Text="{x:Bind ViewModel.Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource QueryFont}" TextWrapping="Wrap" MinHeight="64"
                             PlaceholderText="is:pr review-requested:@me state:open — or paste a github.com search URL"
                             AutomationProperties.AutomationId="QueryExpression" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.ValidationText), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Glyph="{x:Bind local:QueryBuilderView.ValidationGlyph(ViewModel.HasValidationIssues), Mode=OneWay}"
                                  Foreground="{x:Bind local:QueryBuilderView.ValidationBrush(ViewModel.HasValidationIssues), Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ValidationText, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="QueryValidation" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preview" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsPreviewing, Mode=OneWay}" Width="16" Height="16" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.PreviewCommand}" ToolTipService.ToolTip="Run the search now"
                                AutomationProperties.Name="Refresh preview" AutomationProperties.AutomationId="QueryPreview">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.PreviewStatus, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="QueryPreviewStatus" />
                    <Border Style="{StaticResource PanelStyle}" Padding="4" Visibility="{x:Bind ViewModel.HasPreviewItems, Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.PreviewItems}" SelectionMode="None" MaxHeight="300"
                                  AutomationProperties.Name="Preview results" AutomationProperties.AutomationId="QueryPreviewList">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueryPreviewRow">
                                    <Grid ColumnSpacing="10" Padding="0,6" AutomationProperties.Name="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:ItemStateIcon StateKey="{x:Bind StateKey}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ShortTime}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Reference: browse documented qualifiers and add them -->
        <Border x:Name="ReferencePanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Padding="16,14,16,0">
                    <TextBlock Text="Query reference" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Overview}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="3" TextTrimming="WordEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.Overview}" />
                    <AutoSuggestBox PlaceholderText="Search qualifiers" QueryIcon="Find"
                                    Text="{x:Bind ViewModel.QualifierFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Search qualifiers" AutomationProperties.AutomationId="QualifierSearch" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredQualifiers}" SelectedItem="{x:Bind ViewModel.SelectedQualifier, Mode=OneWay}" SelectionChanged="QualifierList_SelectionChanged"
                          SelectionMode="Single" Padding="4,0" AutomationProperties.Name="Qualifiers" AutomationProperties.AutomationId="QualifierList"
                          DoubleTapped="QualifierList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:QualifierDoc">
                            <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="{x:Bind local:QueryBuilderView.QualifierId(Name)}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind local:QueryBuilderView.QualifierLabel(Name)}" FontFamily="{StaticResource QueryFont}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Category}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Summary}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="16,12,16,16"
                        Visibility="{x:Bind local:QueryBuilderView.NotNull(ViewModel.SelectedQualifier), Mode=OneWay}">
                    <StackPanel Spacing="8" AutomationProperties.AutomationId="QualifierDetails">
                        <TextBlock Text="{x:Bind ViewModel.QualifierHeading, Mode=OneWay}" FontFamily="{StaticResource QueryFont}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedQualifier.Summary, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="QualifierSummary" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="Syntax " /><Run Text="{x:Bind ViewModel.SelectedQualifier.Syntax, Mode=OneWay, FallbackValue=''}" FontFamily="{StaticResource QueryFont}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedQualifier.Examples, Mode=OneWay}" AutomationProperties.AutomationId="QualifierExamples">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <HyperlinkButton Click="Example_Click" Tag="{x:Bind}" Padding="4,1" ToolTipService.ToolTip="Add this example to the query"
                                                     AutomationProperties.Name="{x:Bind}">
                                        <TextBlock Text="{x:Bind}" FontFamily="{StaticResource QueryFont}" FontSize="12" />
                                    </HyperlinkButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Bind ViewModel.QualifierChoices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.QualifierValue, Mode=OneWay}" SelectionChanged="QualifierChoice_SelectionChanged"
                                      HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.HasQualifierChoices, Mode=OneWay}"
                                      AutomationProperties.Name="Qualifier value" AutomationProperties.AutomationId="QualifierChoice" />
                            <TextBox Text="{x:Bind ViewModel.QualifierValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.QualifierValueHint, Mode=OneWay}" KeyDown="QualifierValue_KeyDown"
                                     Visibility="{x:Bind ViewModel.HasFreeValue, Mode=OneWay}"
                                     AutomationProperties.Name="Qualifier value" AutomationProperties.AutomationId="QualifierValue" />
                            <CheckBox Grid.Column="1" Content="Exclude" MinWidth="0" IsChecked="{x:Bind ViewModel.ExcludeQualifier, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Exclude matches (prefixes the qualifier with -)"
                                      AutomationProperties.AutomationId="ExcludeQualifier" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.AddQualifierCommand}" Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="AddQualifier">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.QualifierError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.QualifierError), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
