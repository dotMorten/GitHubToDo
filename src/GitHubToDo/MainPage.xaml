<Page
    x:Class="GitHubToDo.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubToDo"
    xmlns:vm="using:GitHubToDo.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:markdown="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="Transparent"
    Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <Style x:Key="DetailsMarkdownStyle" TargetType="markdown:MarkdownTextBlock">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="WrapCodeBlock" Value="True" />
            <Setter Property="UseSyntaxHighlighting" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="LinkForeground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="CodeForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="CodeBackground" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="InlineCodeForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="InlineCodeBackground" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="QuoteForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="QuoteBackground" Value="Transparent" />
            <Setter Property="QuoteBorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="Header1Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Header2Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Header3Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Header4Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Header5Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Header6Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalRuleBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="TableBorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AccentChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueryPillUnreadStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueryPillTextUnreadStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueryPillPendingStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueryPillTextPendingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SubtleToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,28,0,6" />
        </Style>
        <!-- Rows in an app-managed multi-selection; the native TableView only selects one row. -->
        <Style x:Key="MultiSelectedTableRowStyle" TargetType="tabular:TableViewRow">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="GitHubToDo" Subtitle="Inbox"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-32.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="ItemFilterBox" MinWidth="280" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                PlaceholderText="Filter this list by title, repository or person   (Ctrl+F)" QueryIcon="Find"
                                Text="{x:Bind ViewModel.ItemFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind local:MainPage.WorkspaceVisible(ViewModel.IsSettingsOpen, ViewModel.IsSignedIn), Mode=OneWay}"
                                AutomationProperties.Name="Filter items" AutomationProperties.AutomationId="ItemFilter">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button Padding="2" Margin="0,0,8,0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AccountLabel, Mode=OneWay}"
                        AutomationProperties.Name="Account" AutomationProperties.AutomationId="AccountButton">
                    <PersonPicture Width="28" Height="28" DisplayName="{x:Bind ViewModel.AccountLogin, Mode=OneWay}"
                                   ProfilePicture="{x:Bind local:MainPage.Avatar(ViewModel.AccountLogin), Mode=OneWay}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Settings" Click="Settings_Click" AutomationProperties.AutomationId="AccountSettings">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sign out" Command="{x:Bind ViewModel.SignOutCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" AutomationProperties.AutomationId="AccountSignOut">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <StackPanel Grid.Row="1" Margin="12,0,12,4" Spacing="4">
            <InfoBar IsOpen="{x:Bind ViewModel.IsDemo, Mode=OneWay}" Severity="Informational" IsClosable="False" Title="Demo"
                     Message="Isolated local fixture. No OAuth, credentials or GitHub API calls. Every query returns the same three overlapping items."
                     AutomationProperties.AutomationId="DemoBanner" />
            <InfoBar IsOpen="{x:Bind local:MainPage.HasText(ViewModel.Error), Mode=OneWay}"
                     Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>

        <NavigationView x:Name="Navigation" Grid.Row="2" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" PaneDisplayMode="Left" OpenPaneLength="288"
                        DisplayModeChanged="Navigation_DisplayModeChanged"
                        SelectionChanged="Navigation_SelectionChanged"
                        AutomationProperties.AutomationId="QueryNavigation">
            <NavigationView.PaneFooter>
                <Button Click="AddQuery_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,4"
                        Padding="12,8" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                        ToolTipService.ToolTip="Add a saved GitHub search"
                        AutomationProperties.Name="New query" AutomationProperties.AutomationId="AddQuerySidebar">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="New query" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid x:Name="Workspace" Visibility="{x:Bind local:MainPage.WorkspaceVisible(ViewModel.IsSettingsOpen, ViewModel.IsSignedIn), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.RowSpan="2" VerticalAlignment="Top" IsIndeterminate="True" Margin="8,0"
                                 AutomationProperties.AutomationId="RefreshProgress" AutomationProperties.Name="Refreshing"
                                 Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsBusy), Mode=OneWay}" />

                    <Grid Padding="28,20,16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.SelectedQuery.Name, Mode=OneWay, FallbackValue='Saved query'}"
                                           Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Style="{StaticResource AccentChipStyle}"
                                        Visibility="{x:Bind local:MainPage.Visible(ViewModel.SelectedQuery.IsUnread), Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="{x:Bind local:MainPage.CountLabel(ViewModel.SelectedQuery.UnreadCount, 'unread'), Mode=OneWay, FallbackValue=''}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource ChipStyle}">
                                    <TextBlock Text="{x:Bind local:MainPage.CountLabel(ViewModel.Items.Count, 'items'), Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.QueryStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3"
                                       AutomationProperties.AutomationId="QueryCoverageStatus" />
                        </StackPanel>
                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right" OverflowButtonVisibility="Visible" VerticalAlignment="Center"
                                    Background="Transparent" AutomationProperties.AutomationId="QueryActions">
                            <AppBarButton Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                                          ToolTipService.ToolTip="Check for recently updated items (F5)"
                                          AutomationProperties.AutomationId="Refresh">
                                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="View" ToolTipService.ToolTip="Table density and columns" AutomationProperties.AutomationId="TableViewOptions">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8A9;" /></AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <RadioMenuFlyoutItem x:Name="DensityCompact" Text="Compact rows" GroupName="Density" Tag="Compact" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityCompact" />
                                        <RadioMenuFlyoutItem x:Name="DensityStandard" Text="Standard rows" GroupName="Density" Tag="Standard" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityStandard" />
                                        <RadioMenuFlyoutItem x:Name="DensityComfortable" Text="Comfortable rows" GroupName="Density" Tag="Comfortable" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityComfortable" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem x:Name="ColumnsMenu" Text="Columns" AutomationProperties.AutomationId="ColumnsMenu">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutSubItem.Icon>
                                            <ToggleMenuFlyoutItem Text="Unread" Tag="Unread" Click="ColumnToggle_Click" AutomationProperties.AutomationId="ColumnToggle_Unread" />
                                            <ToggleMenuFlyoutItem Text="Repository" Tag="Repository" Click="ColumnToggle_Click" AutomationProperties.AutomationId="ColumnToggle_Repository" />
                                            <ToggleMenuFlyoutItem Text="Author" Tag="Author" Click="ColumnToggle_Click" AutomationProperties.AutomationId="ColumnToggle_Author" />
                                            <ToggleMenuFlyoutItem Text="Updated" Tag="Updated" Click="ColumnToggle_Click" AutomationProperties.AutomationId="ColumnToggle_Updated" />
                                            <ToggleMenuFlyoutItem Text="Flag" Tag="Flag" Click="ColumnToggle_Click" AutomationProperties.AutomationId="ColumnToggle_Flag" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="Reset table layout" Click="ResetTableLayout_Click" AutomationProperties.AutomationId="ResetTableLayout">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Full reconciliation" Icon="Sync" Command="{x:Bind ViewModel.FullRefreshCommand}"
                                              ToolTipService.ToolTip="Recheck all query memberships and discussion histories"
                                              AutomationProperties.AutomationId="FullRefresh" />
                                <AppBarSeparator />
                                <AppBarButton Label="Add query" Icon="Add" Click="AddQuery_Click" AutomationProperties.AutomationId="AddQueryOverflow" />
                                <AppBarButton Label="Edit query" Icon="Edit" Click="EditQuery_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="EditQuery" />
                                <AppBarButton Label="Delete query" Icon="Delete" Click="DeleteQuery_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="DeleteQuery" />
                                <AppBarButton Label="Move query up" Icon="Up" Click="MoveUp_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="MoveQueryUp" />
                                <AppBarButton Label="Move query down" Click="MoveDown_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="MoveQueryDown">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton Label="Focus details" Click="FocusDetails_Click" AutomationProperties.AutomationId="FocusDetails" />
                                <AppBarButton Label="Focus item list" Click="FocusList_Click" AutomationProperties.AutomationId="FocusList" />
                                <AppBarButton Label="Settings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="SettingsOverflow" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="1.25*" MinHeight="160" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <tabular:TableView x:Name="ItemList" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                   SelectionMode="Single" IsReadOnly="True" IsTabStop="True"
                                                   CanUserResizeColumns="True" CanUserSortColumns="True"
                                                   GridLinesVisibility="Horizontal" HeadersVisibility="Column" Density="Standard"
                                                   SelectionChanged="ItemList_SelectionChanged" Sorting="ItemList_Sorting"
                                                   RightTapped="ItemList_RightTapped" PreviewKeyDown="ItemList_PreviewKeyDown"
                                                   AutomationProperties.HelpText="Ctrl-click toggles rows; Shift-click or Shift+arrow extends selection. Ctrl+A selects all rows. Drag column edges to resize; click a header to sort."
                                                   AutomationProperties.AutomationId="ItemList" AutomationProperties.Name="Issues and pull requests">
                                    <tabular:TableView.Columns>
                                        <tabular:TableViewTemplateColumn x:Name="StateColumn" Header="Type" HeaderToolTip="Issue or pull request, and its state"
                                                                         Width="64" MinWidth="56" SortMemberPath="State">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <Grid Loaded="ItemCell_Loaded" DataContextChanged="ItemCell_DataContextChanged" MinHeight="28"
                                                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                                        <Border Width="3" CornerRadius="1.5" Margin="0,8" HorizontalAlignment="Left"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind local:MainPage.Visible(IsUnread), Mode=OneWay}" />
                                                        <local:ItemStateIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             StateKey="{x:Bind StateKey, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="TitleColumn" Header="Title" HeaderToolTip="Title, repository and latest activity"
                                                                         Width="*" MinWidth="200" SortMemberPath="Title">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <StackPanel Spacing="1" Padding="{x:Bind local:TableAppearance.Current.CellPadding, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind local:MainPage.UnreadWeight(IsUnread), Mode=OneWay}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ActivityLine, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Visibility="{x:Bind local:TableAppearance.Current.SecondLineVisibility, Mode=OneWay}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" MaxLines="1" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="UnreadColumn" Header="Unread" HeaderToolTip="Unread comments and reviews (ignored accounts excluded)"
                                                                         Width="84" MinWidth="72" SortMemberPath="Unread">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <Grid Padding="8,0" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource QueryPillUnreadStyle}" HorizontalAlignment="Left"
                                                                Visibility="{x:Bind local:MainPage.Visible(ShowsUnreadCount), Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind UnreadCountText, Mode=OneWay}" Style="{StaticResource QueryPillTextUnreadStyle}"
                                                                       AutomationProperties.AutomationId="{x:Bind UnreadCountAutomationId, Mode=OneWay}"
                                                                       AutomationProperties.Name="{x:Bind UnreadCountDescription, Mode=OneWay}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="RepositoryColumn" Header="Repository" HeaderToolTip="Repository and number"
                                                                         Width="170" MinWidth="90" SortMemberPath="Repository">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind RepositoryNumber, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RepositoryNumber, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="AuthorColumn" Header="Author" HeaderToolTip="Who opened the issue or pull request"
                                                                         Width="140" MinWidth="80" SortMemberPath="Author">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                                                        <PersonPicture Width="20" Height="20" DisplayName="{x:Bind AuthorName, Mode=OneWay}"
                                                                       AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="UpdatedColumn" Header="Updated" HeaderToolTip="Latest relevant comment or review"
                                                                         Width="96" MinWidth="72" SortMemberPath="Updated">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind ShortTime, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ActivityTime, Mode=OneWay}"
                                                               Foreground="{x:Bind local:MainPage.TimeBrush(IsUnread), Mode=OneWay}"
                                                               FontWeight="{x:Bind local:MainPage.UnreadWeight(IsUnread), Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="FlagColumn" Header="Flag" HeaderToolTip="Flagged for follow-up"
                                                                         Width="60" MinWidth="52" SortMemberPath="Flag">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource FollowUpFlagBrush}" AutomationProperties.AccessibilityView="Raw"
                                                              Visibility="{x:Bind local:MainPage.Visible(HasFollowUps), Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                    </tabular:TableView.Columns>
                                    <tabular:TableView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.MarkSelectionReadLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MarkReadCommand}"
                                                            KeyboardAcceleratorTextOverride="Ctrl+Q" AutomationProperties.AutomationId="ContextMarkRead">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C3;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.MarkSelectionUnreadLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MarkUnreadCommand}"
                                                            KeyboardAcceleratorTextOverride="Ctrl+U" AutomationProperties.AutomationId="ContextMarkUnread">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.FlagSelectionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.FlagSelectionCommand}" AutomationProperties.AutomationId="ContextFlag">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Open in GitHub" Command="{x:Bind ViewModel.OpenBrowserCommand}" AutomationProperties.AutomationId="ContextOpenInGitHub">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </tabular:TableView.ContextFlyout>
                                </tabular:TableView>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24" IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.EmptyMessage), Mode=OneWay}">
                                    <Viewbox Width="48" Height="48">
                                        <PathIcon x:Name="EmptyListIcon" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <toolkit:GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" IsTabStop="True"
                                              Background="Transparent"
                                              AutomationProperties.AutomationId="DetailSplitter" AutomationProperties.Name="Resize item list and details" />

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,0">
                                    <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" OverflowButtonVisibility="Visible"
                                                Background="Transparent" AutomationProperties.AutomationId="DetailsActions">
                                        <AppBarButton Label="Mark read" Command="{x:Bind ViewModel.MarkPreviewReadCommand}"
                                                      ToolTipService.ToolTip="Mark this item read. To act on every selected row, right-click the table or press Ctrl+Q."
                                                      AutomationProperties.AutomationId="MarkRead">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C3;" /></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton Label="Mark unread" Command="{x:Bind ViewModel.MarkPreviewUnreadCommand}"
                                                      ToolTipService.ToolTip="Mark this item unread. To act on every selected row, right-click the table or press Ctrl+U."
                                                      AutomationProperties.AutomationId="MarkUnread">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE715;" /></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton Label="{x:Bind ViewModel.SelectedItem.ItemFlagLabel, Mode=OneWay, FallbackValue='Flag item'}"
                                                      Command="{x:Bind ViewModel.ToggleItemFollowUpCommand}"
                                                      AutomationProperties.AutomationId="FlagItem">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE7C1;" /></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarSeparator />
                                        <AppBarButton Label="Summarize" Command="{x:Bind ViewModel.SummarizeCommand}"
                                                      ToolTipService.ToolTip="{x:Bind ViewModel.LocalAiDescription, Mode=OneWay}"
                                                      AutomationProperties.HelpText="{x:Bind ViewModel.LocalAiDescription, Mode=OneWay}"
                                                      AutomationProperties.AutomationId="Summarize">
                                            <AppBarButton.Icon><PathIcon x:Name="SummarizeIcon" /></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton Label="Cancel summary" Icon="Cancel" Command="{x:Bind ViewModel.CancelSummaryCommand}"
                                                      Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSummarizing), Mode=OneWay}"
                                                      AutomationProperties.AutomationId="CancelSummary" />
                                        <AppBarButton Label="Open in GitHub" Command="{x:Bind ViewModel.OpenBrowserCommand}"
                                                      ToolTipService.ToolTip="Open in GitHub (Ctrl+O)" AutomationProperties.AutomationId="OpenInGitHub">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE8A7;" /></AppBarButton.Icon>
                                            <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></AppBarButton.KeyboardAccelerators>
                                        </AppBarButton>
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton Label="Clear all follow-ups for this item" Icon="Clear"
                                                          Command="{x:Bind ViewModel.ClearFollowUpsCommand}"
                                                          AutomationProperties.AutomationId="ClearFollowUps" />
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                </Border>

                                <ListView x:Name="DetailsScroll" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                                          ItemsSource="{x:Bind ViewModel.PreviewActivities, Mode=OneWay}"
                                          HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          Loaded="DetailsScroll_Loaded" PreviewKeyDown="DetailsScroll_PreviewKeyDown"
                                          IsTabStop="True" AutomationProperties.AutomationId="DetailsPane" AutomationProperties.Name="Selected item discussion">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.Header>
                                        <StackPanel x:Name="DiscussionHeader" Padding="24,18,24,10" Spacing="10"
                                                    Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasSelectedItem), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <local:ItemStateIcon ShowLabel="True" StateKey="{x:Bind ViewModel.SelectedItem.StateKey, Mode=OneWay, FallbackValue=''}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.RepositoryNumber, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.ReadLabel, Mode=OneWay, FallbackValue=''}" FontSize="12"
                                                               AutomationProperties.AutomationId="SelectedItemReadStatus" />
                                                </Border>
                                                <FontIcon Glyph="&#xE7C1;" FontSize="14" Foreground="{ThemeResource FollowUpFlagBrush}" VerticalAlignment="Center"
                                                          Visibility="{x:Bind local:MainPage.Visible(ViewModel.SelectedItem.HasFollowUps), Mode=OneWay, FallbackValue=Collapsed}"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay, FallbackValue=''}" Style="{ThemeResource SubtitleTextBlockStyle}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="SelectedItemTitle" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                <Run Text="{x:Bind ViewModel.SelectedItem.Metadata, Mode=OneWay, FallbackValue=''}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{x:Bind ViewModel.SelectedItem.Freshness, Mode=OneWay, FallbackValue=''}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{x:Bind local:MainPage.Visible(ViewModel.SelectedItem.HasFollowUps), Mode=OneWay, FallbackValue=Collapsed}">
                                                <FontIcon Glyph="&#xE7C1;" FontSize="12" Foreground="{ThemeResource FollowUpFlagBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.FollowUpStatus, Mode=OneWay, FallbackValue=''}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="FollowUpStatus" />
                                            </StackPanel>

                                            <Border CornerRadius="8" Padding="16,12" Margin="0,4,0,0" BorderThickness="1"
                                                    BorderBrush="{x:Bind local:MainPage.SummaryAccentBrush(ViewModel.SummaryFailed), Mode=OneWay}"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind local:MainPage.SummaryVisible(ViewModel.IsSummarizing, ViewModel.SummaryStatus, ViewModel.Summary), Mode=OneWay}">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <PathIcon x:Name="SummaryHeaderIcon" Foreground="{x:Bind local:MainPage.SummaryAccentBrush(ViewModel.SummaryFailed), Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind local:MainPage.SummaryTitle(ViewModel.SummaryFailed), Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                                                   AutomationProperties.AutomationId="SummaryTitle" />
                                                    </StackPanel>
                                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSummarizing), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SummaryStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{x:Bind local:MainPage.SummaryStatusBrush(ViewModel.SummaryFailed), Mode=OneWay}"
                                                               Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.SummaryStatus), Mode=OneWay}" AutomationProperties.AutomationId="SummaryStatus" />
                                                    <markdown:MarkdownTextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource DetailsMarkdownStyle}"
                                                               Visibility="{x:Bind local:MainPage.TextVisible(ViewModel.Summary), Mode=OneWay}"
                                                               LinkClicked="Markdown_LinkClicked" ImageResolving="Markdown_ImageResolving"
                                                               AutomationProperties.AutomationId="SummaryMarkdown" AutomationProperties.Name="Local AI summary of selected unread discussions" />
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,8,0,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.DiscussionSummary, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                               AutomationProperties.AutomationId="AllDiscussionStatus" />
                                                    <TextBlock Text="Comments are marked read as you scroll past their ends. Opening alone doesn't mark anything read."
                                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActivityRow">
                                            <Grid Padding="24,6" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <Border Width="3" CornerRadius="1.5" Margin="0,14" HorizontalAlignment="Left"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind local:MainPage.Visible(IsUnread), Mode=OneWay}" />
                                                        <Grid Padding="16,12,12,14" ColumnSpacing="12" RowSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <PersonPicture Grid.RowSpan="2" Width="32" Height="32" VerticalAlignment="Top"
                                                                           DisplayName="{x:Bind Author, Mode=OneWay}"
                                                                           ProfilePicture="{x:Bind local:MainPage.Avatar(Author), Mode=OneWay}"
                                                                           AutomationProperties.AccessibilityView="Raw" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Author, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind Action, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{x:Bind When, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                                                           ToolTipService.ToolTip="{x:Bind Timestamp, Mode=OneWay}" />
                                                                <Border Style="{StaticResource AccentChipStyle}" Padding="8,1" Margin="4,0,0,0"
                                                                        Visibility="{x:Bind local:MainPage.Visible(IsUnread), Mode=OneWay}">
                                                                    <TextBlock Text="New" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                                                <Button Click="CommentReadState_Click" Style="{StaticResource SubtleIconButtonStyle}"
                                                                        ToolTipService.ToolTip="{x:Bind ReadActionLabel, Mode=OneWay}"
                                                                        AutomationProperties.Name="{x:Bind ReadActionLabel, Mode=OneWay}"
                                                                        AutomationProperties.AutomationId="{x:Bind ReadActionAutomationId, Mode=OneWay}">
                                                                    <SymbolIcon Symbol="{x:Bind local:MainPage.ReadActionIcon(IsUnread), Mode=OneWay}" />
                                                                </Button>
                                                                <ToggleButton IsChecked="{x:Bind IsFlagged, Mode=OneWay}" Click="CommentFollowUp_Click"
                                                                              Style="{StaticResource SubtleToggleButtonStyle}" ToolTipService.ToolTip="Flag for follow-up"
                                                                              AutomationProperties.Name="Flag this comment or review for follow-up"
                                                                              AutomationProperties.AutomationId="{x:Bind FlagAutomationId, Mode=OneWay}">
                                                                    <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                                                                </ToggleButton>
                                                            </StackPanel>
                                                            <markdown:MarkdownTextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,4,0"
                                                                       Text="{x:Bind Body, Mode=OneWay}" Style="{StaticResource DetailsMarkdownStyle}"
                                                                       LinkClicked="Markdown_LinkClicked" ImageResolving="Markdown_ImageResolving"
                                                                       AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                                                                       AutomationProperties.Name="Comment or review" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.Footer>
                                        <StackPanel Padding="24,10,24,24" Spacing="10" Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasSelectedItem), Mode=OneWay}">
                                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      AutomationProperties.Name="Issue / PR description (context)"
                                                      AutomationProperties.AutomationId="DescriptionContext">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                                                        <TextBlock Text="Original description" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <markdown:MarkdownTextBlock Text="{x:Bind ViewModel.SelectedItem.Item.Body, Mode=OneWay, FallbackValue=''}"
                                                           Style="{StaticResource DetailsMarkdownStyle}" LinkClicked="Markdown_LinkClicked"
                                                           ImageResolving="Markdown_ImageResolving" AutomationProperties.AutomationId="DescriptionMarkdown"
                                                           AutomationProperties.Name="Selected item description" />
                                            </Expander>
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
                                                <Run Text="Preview links open only HTTPS github.com addresses. Remote images are disabled." />
                                                <LineBreak />
                                                <Run Text="{x:Bind ViewModel.LocalAiDescription, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind ViewModel.LocalAiDescription, Mode=OneWay}" Visibility="Collapsed"
                                                       AutomationProperties.AutomationId="LocalAiAvailability" />
                                        </StackPanel>
                                    </ListView.Footer>
                                </ListView>

                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24" IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainPage.CollapsedWhen(ViewModel.HasSelectedItem), Mode=OneWay}">
                                    <Viewbox Width="56" Height="56">
                                        <PathIcon x:Name="EmptyDetailsIcon" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="Select an item to catch up" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Unread comments and reviews show up here, oldest first." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSettingsOpen), Mode=OneWay}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,28,36,36" MaxWidth="1000" Spacing="4">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="BackToQueries_Click" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSignedIn), Mode=OneWay}"
                                    AutomationProperties.Name="Back to queries" AutomationProperties.AutomationId="BackToQueries">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                    <TextBlock Text="Back to queries" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture Width="72" Height="72" DisplayName="{x:Bind ViewModel.AccountLogin, Mode=OneWay}"
                                               ProfilePicture="{x:Bind local:MainPage.Avatar(ViewModel.AccountLogin), Mode=OneWay}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="GitHub.com issues and pull requests. Read state and follow-up flags stay on this device."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Sign in" Command="{x:Bind ViewModel.SignInCommand}" Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind local:MainPage.CanConfigure(ViewModel.IsSignedIn, ViewModel.IsDeviceFlow), Mode=OneWay}"
                                            AutomationProperties.AutomationId="SignIn" />
                                    <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" AutomationProperties.AutomationId="SignOut" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,8,0,0"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsDeviceFlow), Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Finish signing in on GitHub" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DeviceMessage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="DeviceCode" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open GitHub authorization" Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.OpenVerificationCommand}" AutomationProperties.AutomationId="OpenDeviceAuthorization" />
                                    <Button Content="Cancel sign-in" Command="{x:Bind ViewModel.CancelSignInCommand}" AutomationProperties.AutomationId="CancelSignIn" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                        <toolkit:SettingsCard Header="App theme" Description="Choose light or dark, or follow your Windows setting.">
                            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></toolkit:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemePicker" MinWidth="180" SelectionChanged="ThemePicker_SelectionChanged"
                                      AutomationProperties.Name="App theme" AutomationProperties.AutomationId="AppTheme">
                                <ComboBoxItem Content="Use system setting" Tag="Default" AutomationProperties.AutomationId="ThemeSystem" />
                                <ComboBoxItem Content="Light" Tag="Light" AutomationProperties.AutomationId="ThemeLight" />
                                <ComboBoxItem Content="Dark" Tag="Dark" AutomationProperties.AutomationId="ThemeDark" />
                            </ComboBox>
                        </toolkit:SettingsCard>

                        <TextBlock Text="GitHub connection" Style="{StaticResource SectionHeaderStyle}" />
                        <toolkit:SettingsExpander Header="{x:Bind local:MainPage.OAuthHeader(ViewModel.HasBuiltInClientId)}" IsExpanded="True"
                                                  Description="{x:Bind local:MainPage.OAuthDescription(ViewModel.HasBuiltInClientId)}"
                                                  AutomationProperties.AutomationId="OAuthSettings">
                            <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Header="Client ID" Description="Public identifier, not a secret."
                                                      Visibility="{x:Bind local:MainPage.CollapsedWhen(ViewModel.HasBuiltInClientId)}">
                                    <TextBox MinWidth="300" PlaceholderText="Ov23li…" Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind local:MainPage.CanConfigure(ViewModel.IsSignedIn, ViewModel.IsDeviceFlow), Mode=OneWay}"
                                             AutomationProperties.Name="OAuth client ID (not a secret)" AutomationProperties.AutomationId="OAuthClientId" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="Private repositories"
                                                      Description="Uses GitHub's broad repo scope even though this app never writes to repositories. Your organization may require SSO authorization or app approval.">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IncludePrivate, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind local:MainPage.CanConfigure(ViewModel.IsSignedIn, ViewModel.IsDeviceFlow), Mode=OneWay}"
                                                  AutomationProperties.Name="Request private repository access (repo scope)" AutomationProperties.AutomationId="PrivateScope" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard ContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save configuration" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.AutomationId="SaveConfiguration" />
                                        <HyperlinkButton Content="Register a GitHub OAuth app" NavigateUri="https://github.com/settings/applications/new"
                                                         Visibility="{x:Bind local:MainPage.CollapsedWhen(ViewModel.HasBuiltInClientId)}"
                                                         AutomationProperties.AutomationId="OAuthRegistration" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <StackPanel Spacing="4" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSignedIn), Mode=OneWay}">
                            <TextBlock Text="Noise filtering" Style="{StaticResource SectionHeaderStyle}" />
                            <toolkit:SettingsExpander Header="Ignored accounts" IsExpanded="True"
                                                      Description="Activity from these logins never makes an item unread. Changes apply instantly to cached items; removing an account can reveal unread activity again.">
                                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8F8;" /></toolkit:SettingsExpander.HeaderIcon>
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                            <TextBox AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" PlaceholderText="dependabot[bot]&#x0a;github-actions[bot]"
                                                     Text="{x:Bind ViewModel.IgnoredLogins, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="GitHub logins, one per line (bot names supported)" AutomationProperties.AutomationId="IgnoredAccounts" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button Content="Save ignored accounts" Command="{x:Bind ViewModel.SaveIgnoredCommand}" AutomationProperties.AutomationId="SaveIgnoredAccounts" />
                                                <TextBlock Text="{x:Bind ViewModel.IgnoredStatus, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                        </StackPanel>

                        <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                        <toolkit:SettingsCard Header="How refreshing works"
                                              Description="While this window is open, recently updated items are checked every two minutes with a full reconciliation every 30 minutes. GitHub search is eventually consistent and limited to 1,000 results per query. Badges count loaded items; pending and stale coverage are shown separately. Review requested means direct requests. Nothing runs after you close the app.">
                            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Icons" Description="Issue and pull request icons are GitHub Primer Octicons (MIT license).">
                            <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}"
                       AutomationProperties.AutomationId="ApplicationStatus" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionStatus, Mode=OneWay}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SelectionStatus" />
        </Grid>
    </Grid>
</Page>
