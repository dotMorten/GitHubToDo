<Page
    x:Class="GitHubToDo.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubToDo"
    xmlns:vm="using:GitHubToDo.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:Width="800"
    Background="Transparent"
    Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="QueryPillUnreadStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="QueryPillTextUnreadStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="QueryPillPendingStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="QueryPillTextPendingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Rows in an app-managed multi-selection; the native TableView only selects one row. -->
            <Style x:Key="MultiSelectedTableRowStyle" TargetType="tabular:TableViewRow">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="GitHubToDo" Subtitle="Inbox"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.targetsize-32.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="ItemFilterBox" MinWidth="280" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                PlaceholderText="Filter this list by title, repository or person   (Ctrl+F)" QueryIcon="Find"
                                Text="{x:Bind ViewModel.ItemFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind local:ViewHelpers.CollapsedWhen(ViewModel.IsSettingsOpen), Mode=OneWay}"
                                AutomationProperties.Name="Filter items" AutomationProperties.AutomationId="ItemFilter">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button Padding="2" Margin="0,0,8,0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AccountLabel, Mode=OneWay}"
                        AutomationProperties.Name="Account" AutomationProperties.AutomationId="AccountButton">
                    <PersonPicture Width="28" Height="28" DisplayName="{x:Bind ViewModel.AccountLogin, Mode=OneWay}"
                                   ProfilePicture="{x:Bind local:ViewHelpers.Avatar(ViewModel.AccountLogin), Mode=OneWay}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" IsEnabled="False" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Settings" Click="Settings_Click" AutomationProperties.AutomationId="AccountSettings">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sign out" Command="{x:Bind ViewModel.SignOutCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" AutomationProperties.AutomationId="AccountSignOut">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <StackPanel Grid.Row="1" Margin="12,0,12,4" Spacing="4">
            <InfoBar IsOpen="{x:Bind ViewModel.IsDemo, Mode=OneWay}" Severity="Informational" IsClosable="False" Title="Demo"
                     Message="Isolated local fixture. No OAuth, credentials or GitHub API calls. Every query returns the same three overlapping items."
                     AutomationProperties.AutomationId="DemoBanner" />
            <InfoBar IsOpen="{x:Bind local:ViewHelpers.HasText(ViewModel.Error), Mode=OneWay}"
                     Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>

        <NavigationView x:Name="Navigation" Grid.Row="2" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" PaneDisplayMode="Left" OpenPaneLength="288"
                        DisplayModeChanged="Navigation_DisplayModeChanged"
                        SelectionChanged="Navigation_SelectionChanged"
                        AutomationProperties.AutomationId="QueryNavigation">
            <NavigationView.PaneFooter>
                <Button Click="AddQuery_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,4"
                        Padding="12,8" Background="Transparent" BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                        ToolTipService.ToolTip="Add a saved GitHub search"
                        AutomationProperties.Name="New query" AutomationProperties.AutomationId="AddQuerySidebar">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="New query" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid x:Name="Workspace" Visibility="{x:Bind local:ViewHelpers.CollapsedWhen(ViewModel.IsSettingsOpen), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="28,20,16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.SelectedQuery.Name, Mode=OneWay, FallbackValue='Saved query'}"
                                           Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Style="{StaticResource AccentChipStyle}"
                                        Visibility="{x:Bind local:ViewHelpers.Visible(ViewModel.SelectedQuery.IsUnread), Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="{x:Bind local:ViewHelpers.CountLabel(ViewModel.SelectedQuery.UnreadCount, 'unread'), Mode=OneWay, FallbackValue=''}"
                                               AutomationProperties.AutomationId="QueryUnreadCount"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource ChipStyle}">
                                    <TextBlock Text="{x:Bind local:ViewHelpers.CountLabel(ViewModel.Items.Count, 'items'), Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedQuery.Query.Expression, Mode=OneWay, FallbackValue=''}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind local:ViewHelpers.TextVisible(ViewModel.SelectedQuery.Query.Expression), Mode=OneWay, FallbackValue=Collapsed}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedQuery.Query.Expression, Mode=OneWay, FallbackValue=''}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3"
                                       AutomationProperties.AutomationId="QuerySearchExpression" />
                        </StackPanel>
                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right" OverflowButtonVisibility="Visible" VerticalAlignment="Center"
                                    Background="Transparent" AutomationProperties.AutomationId="QueryActions">
                            <AppBarButton Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"
                                          ToolTipService.ToolTip="Refresh the active view (F5)"
                                          AutomationProperties.AutomationId="Refresh">
                                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="View" ToolTipService.ToolTip="Table density and columns" AutomationProperties.AutomationId="TableViewOptions">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8A9;" /></AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <RadioMenuFlyoutItem x:Name="DensityCompact" Text="Compact rows" GroupName="Density" Tag="Compact" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityCompact" />
                                        <RadioMenuFlyoutItem x:Name="DensityStandard" Text="Standard rows" GroupName="Density" Tag="Standard" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityStandard" />
                                        <RadioMenuFlyoutItem x:Name="DensityComfortable" Text="Comfortable rows" GroupName="Density" Tag="Comfortable" Click="Density_Click"
                                                             AutomationProperties.AutomationId="DensityComfortable" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem x:Name="ColumnsMenu" Text="Columns" AutomationProperties.AutomationId="ColumnsMenu">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutSubItem.Icon>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="Reset table layout" Click="ResetTableLayout_Click" AutomationProperties.AutomationId="ResetTableLayout">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Full reconciliation" Icon="Sync" Command="{x:Bind ViewModel.FullRefreshCommand}"
                                              ToolTipService.ToolTip="Recheck all query memberships and discussion histories"
                                              AutomationProperties.AutomationId="FullRefresh" />
                                <AppBarSeparator />
                                <AppBarButton Label="Add query" Icon="Add" Click="AddQuery_Click" AutomationProperties.AutomationId="AddQueryOverflow" />
                                <AppBarButton Label="Edit query" Icon="Edit" Click="EditQuery_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="EditQuery" />
                                <AppBarButton Label="Delete query" Icon="Delete" Click="DeleteQuery_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="DeleteQuery" />
                                <AppBarButton Label="Move query up" Icon="Up" Click="MoveUp_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="MoveQueryUp" />
                                <AppBarButton Label="Move query down" Click="MoveDown_Click" IsEnabled="{x:Bind ViewModel.CanEditSelectedQuery, Mode=OneWay}" AutomationProperties.AutomationId="MoveQueryDown">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton Label="Focus details" Click="FocusDetails_Click" AutomationProperties.AutomationId="FocusDetails" />
                                <AppBarButton Label="Focus item list" Click="FocusList_Click" AutomationProperties.AutomationId="FocusList" />
                                <AppBarButton Label="Settings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="SettingsOverflow" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="1.25*" MinHeight="160" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <tabular:TableView x:Name="ItemList" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                   SelectionMode="Single" IsReadOnly="True" IsTabStop="True"
                                                   CanUserResizeColumns="True" CanUserSortColumns="True"
                                                   GridLinesVisibility="Horizontal" HeadersVisibility="Column" Density="Standard"
                                                   SelectionChanged="ItemList_SelectionChanged" Sorting="ItemList_Sorting"
                                                   RightTapped="ItemList_RightTapped" PreviewKeyDown="ItemList_PreviewKeyDown"
                                                   AutomationProperties.HelpText="Ctrl-click toggles rows; Shift-click or Shift+arrow extends selection. Ctrl+A selects all rows. Drag column edges to resize; click a header to sort; right-click a header to choose columns."
                                                   AutomationProperties.AutomationId="ItemList" AutomationProperties.Name="Issues and pull requests">
                                    <tabular:TableView.Columns>
                                        <tabular:TableViewTemplateColumn x:Name="StateColumn" Header="State" HeaderToolTip="Issue or pull request, and its state"
                                                                         Width="64" MinWidth="56" SortMemberPath="State">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <Grid Loaded="ItemCell_Loaded" DataContextChanged="ItemCell_DataContextChanged" MinHeight="28"
                                                          AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                                        <Border Width="3" CornerRadius="1.5" Margin="0,8" HorizontalAlignment="Left"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{x:Bind local:ViewHelpers.Visible(IsUnread), Mode=OneWay}" />
                                                        <local:ItemStateIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             StateKey="{x:Bind StateKey, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="TitleColumn" Header="Title" HeaderToolTip="Title, repository and latest activity"
                                                                         Width="*" MinWidth="200" SortMemberPath="Title">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <StackPanel Spacing="1" Padding="{x:Bind local:TableAppearance.Current.CellPadding, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind local:ViewHelpers.UnreadWeight(IsUnread), Mode=OneWay}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ActivityLine, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Visibility="{x:Bind local:TableAppearance.Current.SecondLineVisibility, Mode=OneWay}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" MaxLines="1" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="UnreadColumn" Header="Unread" HeaderToolTip="Unread comments and reviews (ignored accounts excluded)"
                                                                         Width="84" MinWidth="72" SortMemberPath="Unread">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <Grid Padding="8,0" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource QueryPillUnreadStyle}" HorizontalAlignment="Left"
                                                                Visibility="{x:Bind local:ViewHelpers.Visible(ShowsUnreadCount), Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind UnreadCountText, Mode=OneWay}" Style="{StaticResource QueryPillTextUnreadStyle}"
                                                                       AutomationProperties.AutomationId="{x:Bind UnreadCountAutomationId, Mode=OneWay}"
                                                                       AutomationProperties.Name="{x:Bind UnreadCountDescription, Mode=OneWay}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="RepositoryColumn" Header="Repository" HeaderToolTip="Repository and number"
                                                                         Width="170" MinWidth="90" SortMemberPath="Repository">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind RepositoryNumber, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RepositoryNumber, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="AuthorColumn" Header="Author" HeaderToolTip="Who opened the issue or pull request"
                                                                         Width="140" MinWidth="80" SortMemberPath="Author">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                                                        <PersonPicture Width="20" Height="20" DisplayName="{x:Bind AuthorName, Mode=OneWay}"
                                                                       AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="UpdatedColumn" Header="Updated" HeaderToolTip="Latest relevant comment or review"
                                                                         Width="96" MinWidth="72" SortMemberPath="Updated">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind ShortTime, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ActivityTime, Mode=OneWay}"
                                                               Foreground="{x:Bind local:ViewHelpers.TimeBrush(IsUnread), Mode=OneWay}"
                                                               FontWeight="{x:Bind local:ViewHelpers.UnreadWeight(IsUnread), Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn x:Name="FlagColumn" Header="Flag" HeaderToolTip="Flagged for follow-up"
                                                                         Width="60" MinWidth="52" SortMemberPath="Flag">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource FollowUpFlagBrush}" AutomationProperties.AccessibilityView="Raw"
                                                              Visibility="{x:Bind local:ViewHelpers.Visible(HasFollowUps), Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Labels" Width="200" MinWidth="100" SortMemberPath="Labels" Visibility="Collapsed">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind Labels, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ColumnMetadataStatus, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Type" HeaderToolTip="GitHub issue type, such as Bug, Feature, or Task"
                                                                         Width="120" MinWidth="80" SortMemberPath="IssueType" Visibility="Collapsed">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind IssueType, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ColumnMetadataStatus, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Milestone" Width="160" MinWidth="100" SortMemberPath="Milestone" Visibility="Collapsed">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind Milestone, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ColumnMetadataStatus, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Priority" HeaderToolTip="The Priority custom field from accessible GitHub Projects"
                                                                         Width="160" MinWidth="100" SortMemberPath="Priority" Visibility="Collapsed">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind Priority, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ColumnMetadataStatus, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Effort" HeaderToolTip="The Effort custom field from accessible GitHub Projects"
                                                                         Width="160" MinWidth="100" SortMemberPath="Effort" Visibility="Collapsed">
                                            <tabular:TableViewTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:ItemRow">
                                                    <TextBlock Text="{x:Bind Effort, Mode=OneWay}" Margin="8,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ColumnMetadataStatus, Mode=OneWay}" />
                                                </DataTemplate>
                                            </tabular:TableViewTemplateColumn.CellTemplate>
                                        </tabular:TableViewTemplateColumn>
                                    </tabular:TableView.Columns>
                                    <tabular:TableView.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.MarkSelectionReadLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MarkReadCommand}"
                                                            KeyboardAcceleratorTextOverride="Ctrl+Q" AutomationProperties.AutomationId="ContextMarkRead">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C3;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.MarkSelectionUnreadLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MarkUnreadCommand}"
                                                            KeyboardAcceleratorTextOverride="Ctrl+U" AutomationProperties.AutomationId="ContextMarkUnread">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind ViewModel.FlagSelectionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.FlagSelectionCommand}" AutomationProperties.AutomationId="ContextFlag">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Open in GitHub" Command="{x:Bind ViewModel.OpenBrowserCommand}" AutomationProperties.AutomationId="ContextOpenInGitHub">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </tabular:TableView.ContextFlyout>
                                </tabular:TableView>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24" IsHitTestVisible="False"
                                            Visibility="{x:Bind local:ViewHelpers.TextVisible(ViewModel.EmptyMessage), Mode=OneWay}">
                                    <Viewbox Width="48" Height="48">
                                        <PathIcon x:Name="EmptyListIcon" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <toolkit:GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" IsTabStop="True"
                                              Background="Transparent"
                                              AutomationProperties.AutomationId="DetailSplitter" AutomationProperties.Name="Resize item list and details" />

                        <local:ItemDetailsView x:Name="ItemDetails" Grid.Row="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <local:SettingsView ViewModel="{x:Bind ViewModel, Mode=OneWay}" BackRequested="BackToQueries_Click"
                                    Visibility="{x:Bind local:ViewHelpers.Visible(ViewModel.IsSettingsOpen), Mode=OneWay}" d:Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="14" Height="14" MinWidth="0" MinHeight="0" Margin="0,0,8,0" VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind local:ViewHelpers.Visible(ViewModel.IsBusy), Mode=OneWay}"
                              AutomationProperties.AutomationId="RefreshProgress" AutomationProperties.Name="Refreshing" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}"
                           AutomationProperties.AutomationId="ApplicationStatus" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionStatus, Mode=OneWay}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SelectionStatus" />
        </Grid>
    </Grid>
</Page>
