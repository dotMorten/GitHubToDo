<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GitHubToDo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:markdown="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:local="using:GitHubToDo">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <TabularControlsResources xmlns="using:Microsoft.UI.Xaml.Controls.Tabular" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StateOpenBrush" Color="#1A7F37" />
                    <SolidColorBrush x:Key="StateMergedBrush" Color="#8250DF" />
                    <SolidColorBrush x:Key="StateClosedBrush" Color="#CF222E" />
                    <SolidColorBrush x:Key="StateOpenFillBrush" Color="#1F883D" />
                    <SolidColorBrush x:Key="StateMergedFillBrush" Color="#8250DF" />
                    <SolidColorBrush x:Key="StateClosedFillBrush" Color="#CF222E" />
                    <SolidColorBrush x:Key="StatePillForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FollowUpFlagBrush" Color="#C4314B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StateOpenBrush" Color="#3FB950" />
                    <SolidColorBrush x:Key="StateMergedBrush" Color="#A371F7" />
                    <SolidColorBrush x:Key="StateClosedBrush" Color="#F85149" />
                    <SolidColorBrush x:Key="StateOpenFillBrush" Color="#238636" />
                    <SolidColorBrush x:Key="StateMergedFillBrush" Color="#8957E5" />
                    <SolidColorBrush x:Key="StateClosedFillBrush" Color="#DA3633" />
                    <SolidColorBrush x:Key="StatePillForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FollowUpFlagBrush" Color="#FF6B81" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StateOpenBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateMergedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateClosedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateOpenFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StateMergedFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StateClosedFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StatePillForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="FollowUpFlagBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="DetailsMarkdownStyle" TargetType="markdown:MarkdownTextBlock">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="WrapCodeBlock" Value="True" />
                <Setter Property="UseSyntaxHighlighting" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="LinkForeground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="CodeForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="CodeBackground" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="InlineCodeForeground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="InlineCodeBackground" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="QuoteForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="QuoteBackground" Value="Transparent" />
                <Setter Property="QuoteBorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="Header1Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Header2Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Header3Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Header4Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Header5Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Header6Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalRuleBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="TableBorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="AccentChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubtleToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
